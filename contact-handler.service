[Unit]
Description=Tissuecare iletişim formu mail gönderici (Node.js)
After=network.target

[Service]
Type=simple
Environment=PORT=8091
WorkingDirectory=/home/tissuecarebiotech
ExecStart=/usr/bin/node /home/tissuecarebiotech/contact-handler.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
